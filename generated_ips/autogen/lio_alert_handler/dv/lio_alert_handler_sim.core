name: lowrisc:opentitan:lio_alert_handler_sim:0.1
description: "LIO_ALERT_HANDLER DV sim target"
filesets:
  files_rtl:
    depend:
      - lowrisc:opentitan:lio_alert_handler:0.1
    file_type: systemVerilogSource

  files_dv:
    depend:
      - lowrisc:dv:ralgen
      - lowrisc:opentitan:lio_alert_handler_tb:0.1
      - lowrisc:opentitan:lio_alert_handler_cov:0.1
      - lowrisc:opentitan:lio_alert_handler_sva:0.1
    file_type: systemVerilogSource

generate:
  ral:
    generator: ralgen
    parameters:
      name: lio_alert_handler
      ip_hjson: ../data/lio_alert_handler.hjson

targets:
  sim: &sim_target
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    generate:
      - ral
    default_tool: vcs

  lint:
    <<: *sim_target
