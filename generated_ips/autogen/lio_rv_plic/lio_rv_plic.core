CAPI=2:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: lowrisc:opentitan:lio_rv_plic:0.1
description: "RISC-V Platform Interrupt Controller (PLIC)"

filesets:
  files_rtl:
    depend:
      - lowrisc:opentitan:lio_rv_plic_component:0.1
      - lowrisc:ip:tlul
      - lowrisc:prim:subreg
      - lowrisc:systems:top_racl_pkg
    files:
      - rtl/lio_rv_plic_reg_pkg.sv
      - rtl/lio_rv_plic_reg_top.sv
      - rtl/lio_rv_plic.sv
    file_type: systemVerilogSource

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: lio_rv_plic

  lint:
    <<: *default_target
    default_tool: verilator
    parameters:
      - SYNTHESIS=true
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
