name: lowrisc:darjeeling_dv:lio_pwm_sim:0.1
description: "LIO_PWM DV sim target"
filesets:
  files_rtl:
    depend:
      - lowrisc:darjeeling_ip:lio_pwm:0.1
      - lowrisc:prim:assert

  files_dv:
    depend:
      - lowrisc:darjeeling_dv:lio_pwm_test
      - lowrisc:darjeeling_dv:lio_pwm_sva
    files:
      - tb.sv
    file_type: systemVerilogSource

targets:
  sim: &sim_target
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    default_tool: vcs

  lint:
    <<: *sim_target
