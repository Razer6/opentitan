CAPI=2:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:systems:top_mio:0.1"
description: "Technology-independent Mio toplevel"
filesets:
  files_rtl_generic:
    depend:
      # Place the autogen packages first to avoid conflicts
      - lowrisc:ip:uart:0.1
      - lowrisc:ip:gpio
      - lowrisc:ip:rv_core_ibex
      - lowrisc:ibex:ibex_tracer
      - lowrisc:ip:rv_dm
      - lowrisc:ip:rv_timer
      - lowrisc:ip:tlul
      - lowrisc:prim:ram_1p_scr
      - lowrisc:ip:sram_ctrl
      - lowrisc:constants:top_pkg
      # Use only a single package shared between Darjeeling, MIO, PWC
      - lowrisc:constants:top_darjeeling_jtag_id_pkg
      - lowrisc:constants:top_darjeeling_ibex_pmp_reset_pkg
      - lowrisc:ip:lc_ctrl_pkg
      - lowrisc:ip:dma
      - lowrisc:ip:mbx
      - lowrisc:top_mio:xbar_mio_main
      - lowrisc:top_mio:xbar_mio_mbx
      - lowrisc:top_mio:xbar_mio_peri
      - lowrisc:opentitan:top_mio_rv_plic_mio
      - lowrisc:ip:aon_timer
      - lowrisc:systems:top_mio_soc_proxy
      - lowrisc:tlul:headers
      - lowrisc:prim:all
      - lowrisc:prim:mubi
      - lowrisc:systems:top_mio_pkg
    files:
      - rtl/autogen/top_mio_rnd_cnst_pkg.sv
      - rtl/autogen/top_mio.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_mio.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_mio.waiver
    file_type: waiver

  files_veriblelint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_mio.vbw
    file_type: veribleLintWaiver


parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

targets:
  default: &default_target
    filesets:
      - tool_verilator   ? (files_verilator_waiver)
      - tool_ascentlint  ? (files_ascentlint_waiver)
      - tool_veriblelint ? (files_veriblelint_waiver)
      - files_rtl_generic
    toplevel: top_mio

  sim:
    default_tool: icarus
    filesets:
      - files_rtl_generic
    toplevel: top_mio

  lint:
    <<: *default_target
    default_tool: verilator
    parameters:
      - SYNTHESIS=true
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"

  syn:
    <<: *default_target
    # TODO: set default to DC once
    # this option is available
    # olofk/edalize#89
    default_tool: icarus
    parameters:
      - SYNTHESIS=true
    toplevel: top_mio

  formal:
    <<: *default_target
    toplevel: top_mio
