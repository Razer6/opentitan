name: "lowrisc:systems:top_mio:0.1"
description: "Technology-independent Mio toplevel"
filesets:
  files_rtl_generic:
    depend:
      - lowrisc:prim_rdp:all
      # Place the autogen packages first to avoid conflicts
      - lowrisc:ip:uart:0.1
      - lowrisc:ip:rv_dm
      - lowrisc:ip:rv_timer
      - lowrisc:ip:tlul
      - lowrisc:prim:ram_1p_scr
      - lowrisc:ip:sram_ctrl
      # Use only a single package shared between Darjeeling, MIO, PWC
      - lowrisc:darjeeling_constants:top_pkg
      - lowrisc:constants:top_darjeeling_jtag_id_pkg
      - lowrisc:constants:top_darjeeling_ibex_pmp_reset_pkg
      - lowrisc:ip:lc_ctrl_pkg
      - lowrisc:ip:dma
      - lowrisc:ip:mbx
      - lowrisc:top_mio:xbar_mio_main
      - lowrisc:top_mio:xbar_mio_mbx
      - lowrisc:top_mio:xbar_mio_peri
      - lowrisc:mio_ip:ac_range_check_mio
      - lowrisc:mio_ip:racl_ctrl_mio
      - lowrisc:mio_ip:rv_plic_mio
      - lowrisc:mio_ip:rv_core_ibex_mio
      - lowrisc:ip:aon_timer
      - lowrisc:systems:top_mio_soc_proxy
      - lowrisc:tlul:headers
      - lowrisc:prim:all
      - lowrisc:prim:mubi
      - lowrisc:systems:top_mio_pkg
      - "!synth_run? (lowrisc:ibex:ibex_tracer)"
    files:
      - rtl/autogen/top_mio_racl_pkg.sv
      - rtl/autogen/top_mio.sv
    file_type: systemVerilogSource

  files_rtl_testing:
    depend:
      - lowrisc:mio_constants:testing_rnd_cnst_pkg
      - lowrisc:darjeeling_constants:testing_lc_ctrl_state_pkg

  files_rtl_tapeout:
    depend:
      - lowrisc:mio_constants:tapeout_rnd_cnst_pkg
      - lowrisc:darjeeling_constants:tapeout_lc_ctrl_state_pkg

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_mio.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_mio.waiver
      - lint/rivos_top.waiver
    file_type: waiver

  files_veriblelint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_mio.vbw
    file_type: veribleLintWaiver

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine
  RDV_NO_SYSCTL:
    datatype: bool
    default: true
    paramtype: vlogdefine
  PRIM_DEFAULT_IMPL:
    datatype: str
    paramtype: vlogdefine
    description: Use the RDP primitive library
    default: prim_pkg::ImplRdp

targets:
  default: &default_target
    filesets:
      - tool_verilator    ? (files_verilator_waiver)
      - tool_ascentlint   ? (files_ascentlint_waiver)
      - tool_veriblelint  ? (files_veriblelint_waiver)
      - fileset_tapeout   ? (files_rtl_tapeout)
      - "!fileset_tapeout ? (files_rtl_testing)"
      - files_rtl_generic
    toplevel: top_mio
    parameters:
      - PRIM_DEFAULT_IMPL

  sim:
    default_tool: icarus
    parameters_append:
      - RDV_NO_SYSCTL=true
      - PRIM_DEFAULT_IMPL
    filesets:
      - files_rtl_generic
    toplevel: top_mio

  lint:
    <<: *default_target
    default_tool: verilator
    parameters_append:
      - SYNTHESIS=true
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"

  syn:
    <<: *default_target
    # TODO: set default to DC once
    # this option is available
    # olofk/edalize#89
    default_tool: icarus
    parameters_append:
      - SYNTHESIS=true
    toplevel: top_mio

  formal:
    <<: *default_target
    toplevel: top_mio
