name: lowrisc:mio_dv:ac_range_check_mio_mio_sim:0.1
description: "AC_RANGE_CHECK DV sim target"
filesets:
  files_rtl:
    depend:
      - lowrisc:ip:tlul
      - lowrisc:mio_ip:ac_range_check_mio_mio:0.1
    file_type: systemVerilogSource

  files_dv:
    depend:
      - lowrisc:mio_dv:ac_range_check_mio_mio_test
      - lowrisc:mio_dv:ac_range_check_mio_mio_sva
    files:
      - tb/tb.sv
    file_type: systemVerilogSource

targets:
  sim: &sim_target
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    default_tool: vcs

  lint:
    <<: *sim_target
