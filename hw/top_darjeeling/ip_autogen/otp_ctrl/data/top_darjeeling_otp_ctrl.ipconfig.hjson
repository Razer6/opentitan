              inv_default: 0
              offset: 192
            }
            {
              name: CREATOR_SW_CFG_ROM_PERMISSIVE_SECURITY
              size: 4
              desc:
                '''
                Silicon Creator chicken bits for the ROM.
                Chicken bits allow Silicon Creators to enable or
                disable specific features or functionalities as a
                precaution or a workaround.
                This 32-bit word is free to use by vendors to define
                their own chicken bits, and managed them from vendor
                specific hooks.

                The Rivos-defined chicken bits for GA0 are described
                below:
                0: Enable secure boot. Secure boot is enabled iff
                   this bit is set. OTBN is not loaded with any code
                   when this bit is not set.
                1: Signature generation. Asset signatures are
                   generated iff this bit and the secure boot ones
                   are set.
                2: Signature verification. Asset signatures are
                   verified iff this bit, the signature generation and
                   the secure boot bits are set.
                3: External assets verification. Assets from external
                   flash are verified iff this bit, both the secure
                   signature verification and validation, and the secure
                   boot bits are all set.
                4: Shared SRAM memory repair. The SCS shared SRAM memory
                   is repaired iff this bit is not set.
                5: D2D East SRAM memory repair. The D2D East SRAM memory
                   is repaired iff this bit is not set.
                6: SPI flash memory reset. The SPI flash memory RESET pin
                   is toggled at the end of the second ROM preamble iff
                   this bit is not set.
                7-31: reserved
                '''
              isdigest: false
              ismubi: false
              iskeymgr_creator: false
              iskeymgr_owner: false
              inv_default: 0
              offset: 224
            }
            {
              name: CREATOR_SW_CFG_BOOTSTRAP_FW_OWNERS_MASK
              size: 4
              desc:
                '''
                Bootstrap firmware owners' mask
                Allowed and required lists of owners associated with
                the signature of the bootstrap firmware bundle.

                Contains two masks, one for the allowed owners, which
                means the list of owners that can sign the bundle, and
                another one for the required owners, which means the
                list of owners that must sign the bundle.

                This is distributed over a 32-bit word described as
                follows:
                0-3: Allowed list of owners
                4-7: Required list of owners
                8-31: reserved

                Each bit of each 4-bit field (allowed or required) is
                associated with a distinct owner, shifted according to
                its value.
                Given the key owner `Silicon Creator` is represented
                by 0, the owners' mask that represents this owner for
                both allowed and required lists would be 0b00010001
                (17 in decimal).
                '''
              isdigest: false
              ismubi: false
              iskeymgr_creator: false
              iskeymgr_owner: false
              inv_default: 0
              offset: 228
            }
            {
              name: CREATOR_SW_CFG_ROM_EXT_OWNERS_MASK
              size: 4
              desc:
                '''
                ROM extension owners' mask
                Allowed and required lists of owners associated with
                the signature of the ROM extension partition/bundle.

                Contains two masks, one for the allowed owners, which
                means the list of owners that can sign the bundle, and
                another one for the required owners, which means the
                list of owners that must sign the bundle.

                This is distributed over a 32-bit word described as
                follows:
                0-3: Allowed list of owners
                4-7: Required list of owners
                8-31: reserved

                Each bit of each 4-bit field (allowed or required) is
                associated with a distinct owner, shifted according to
                its value.
                Given the key owner `Silicon Creator` is represented
                by 0 and the key owner `Platform Owner` is represented
                by 3, the owners' mask that represents both of these
                owners for both allowed and required lists would be
                0b10011001 (153 in decimal).
                '''
              isdigest: false
              ismubi: false
              iskeymgr_creator: false
              iskeymgr_owner: false
              inv_default: 0
              offset: 232
