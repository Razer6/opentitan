name: "lowrisc:darjeeling_constants:top_racl_pkg:0.1"
description: "Autogenerated top_darjeeling_racl_pkg used in RTL and DV."
virtual:
  - lowrisc:virtual_constants:top_racl_pkg

filesets:
  files_rtl:
    depend:
      - lowrisc:darjeeling_constants:top_pkg
      - lowrisc:tlul:headers
    files:
      - rtl/autogen/top_racl_pkg.sv
    file_type: systemVerilogSource

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_racl_pkg.waiver
    file_type: waiver

targets:
  default: &default_target
    filesets:
      - tool_ascentlint  ? (files_ascentlint_waiver)
      - files_rtl
