{
  error_response: false
  ctn_uid_bit_lsb: 0
  ctn_uid_bit_msb: 4
  role_bit_lsb: 5
  role_bit_msb: 8
  roles: {
    "NOT_TEE" :       { role_id: 0  }
    "M_MODE":         { role_id: 1  }
    "TEE_MODE":       { role_id: 2  }
    "R_CODE":         { role_id: 3  }
    "CAT2_DEBUG":     { role_id: 4  }
    "CAT3_DEBUG":     { role_id: 5  }
    "ROT":            { role_id: 6  }
    "MIO":            { role_id: 7  }
    "PWC":            { role_id: 8  }
    "INT_SOC":        { role_id: 9  }
    "IO_AGENT":       { role_id: 10 }
    "TEE_IO_AGENT":   { role_id: 11 }
    "DUC_UC":         { role_id: 12 }
    "MIMT_R_MODE":    { role_id: 13 }
  }
  policies: {
    Null: [
      // Standard policies allowing all roles to access a register
      { name: "all_rd_wr_policy"
        allowed_wr: [ "NOT_TEE", "M_MODE", "TEE_MODE", "R_CODE", "CAT2_DEBUG", "CAT3_DEBUG", "ROT", "MIO", "PWC", "INT_SOC", "IO_AGENT", "TEE_IO_AGENT", "DUC_UC", "MIMT_R_MODE" ]
        allowed_rd: [ "NOT_TEE", "M_MODE", "TEE_MODE", "R_CODE", "CAT2_DEBUG", "CAT3_DEBUG", "ROT", "MIO", "PWC", "INT_SOC", "IO_AGENT", "TEE_IO_AGENT", "DUC_UC", "MIMT_R_MODE" ]
      }
      { name: "hw_rot_pwc_wr_all_rd_policy"
        allowed_wr: [ "CAT3_DEBUG", "ROT", "PWC", "INT_SOC" ]
        allowed_rd: [ "NOT_TEE", "M_MODE", "TEE_MODE", "R_CODE", "CAT2_DEBUG", "CAT3_DEBUG", "ROT", "MIO", "PWC", "INT_SOC", "IO_AGENT", "TEE_IO_AGENT", "DUC_UC", "MIMT_R_MODE" ]
      }
      { name: "pre_boot_m_policy"
        allowed_wr: [ "M_MODE", "R_CODE", "CAT2_DEBUG", "CAT3_DEBUG", "ROT", "PWC", "INT_SOC" ]
        allowed_rd: [ "NOT_TEE", "M_MODE", "TEE_MODE", "R_CODE", "CAT2_DEBUG", "CAT3_DEBUG", "ROT", "MIO", "PWC", "INT_SOC" ]
      }
      { name: "post_boot_m_policy"
        allowed_wr: [ "M_MODE", "R_CODE", "CAT2_DEBUG", "CAT3_DEBUG", "ROT", "PWC", "INT_SOC" ]
        allowed_rd: [ "NOT_TEE", "M_MODE", "TEE_MODE", "R_CODE", "CAT2_DEBUG", "CAT3_DEBUG", "ROT", "MIO", "PWC", "INT_SOC" ]
      }
      { name: "tee_limited_policy"
        allowed_wr: [ "TEE_MODE", "R_CODE", "CAT2_DEBUG", "CAT3_DEBUG", "ROT", "PWC", "INT_SOC", "TEE_IO_AGENT" ]
        allowed_rd: [ "TEE_MODE", "R_CODE", "CAT2_DEBUG", "CAT3_DEBUG", "ROT", "PWC", "INT_SOC", "TEE_IO_AGENT" ]
      }
      { name: "rcode_private_policy"
        allowed_wr: [ "R_CODE", "CAT3_DEBUG", "ROT", "PWC", "INT_SOC" ]
        allowed_rd: [ "R_CODE", "CAT3_DEBUG", "ROT", "PWC", "INT_SOC" ]
      }
      { name: "rot_private_policy"
        rot_private: true
        allowed_wr: [ "CAT3_DEBUG", "ROT" ]
        allowed_rd: [ "CAT3_DEBUG", "ROT" ]
      }
      { name: "pwc_private_policy"
        allowed_wr: [ "CAT3_DEBUG", "ROT", "PWC", "INT_SOC" ]
        allowed_rd: [ "CAT3_DEBUG", "ROT", "PWC", "INT_SOC" ]
      }
      { name: "mio_private_policy"
        allowed_wr: [ "CAT3_DEBUG", "ROT", "MIO", "PWC", "INT_SOC" ]
        allowed_rd: [ "CAT3_DEBUG", "ROT", "MIO", "PWC", "INT_SOC" ]
      }
      { name: "duc_private_policy"
        allowed_wr: [ "CAT3_DEBUG", "ROT", "PWC", "INT_SOC", "DUC_UC", "MIMT_R_MODE" ]
        allowed_rd: [ "CAT3_DEBUG", "ROT", "PWC", "INT_SOC", "DUC_UC", "MIMT_R_MODE" ]
      }
    ]
  }
}
