# Rivos waiver for Rivos tops

waive -rules VAR_INDEX_RANGE -location {dm_mem.sv} \
      -comment "Waive in Rivos environment, which uses a differnt default rule set"
waive -rules VAR_INDEX_RANGE -location {rom_ctrl_compare.sv} \
      -comment "Waive in Rivos environment, which uses a differnt default rule set"
waive -rules VAR_INDEX_RANGE -location {keccak_2share.sv} \
      -comment "Waive in Rivos environment, which uses a differnt default rule set"

waive -rules SAME_NAME_TYPE -location {keccak_2share.sv} -regexp {'L' is used as a (parameter|reg) here, and as a (reg|parameter) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
