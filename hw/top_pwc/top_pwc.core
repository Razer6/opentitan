# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:systems:top_pwc:0.1"
description: "Technology-independent Pwc toplevel"
filesets:
  files_rtl_generic:
    depend:
      # Place the autogen packages first to avoid conflicts
      - lowrisc:ip:uart:0.1
      - lowrisc:ip:gpio
      - lowrisc:ip:rv_core_ibex
      - lowrisc:ip:rv_dm
      - lowrisc:ip:rv_timer
      - lowrisc:ip:tlul
      - lowrisc:prim:ram_1p_scr
      - lowrisc:ip:sram_ctrl
      - lowrisc:constants:top_pkg
      - lowrisc:constants:top_pwc_jtag_id_pkg
      - lowrisc:constants:top_pwc_ibex_pmp_reset_pkg
      - lowrisc:ip:lc_ctrl_pkg
      - lowrisc:ip:dma
      - lowrisc:ip:mbx
      - lowrisc:top_pwc:xbar_main
      - lowrisc:top_pwc:xbar_mbx
      - lowrisc:top_pwc:xbar_peri
      - lowrisc:opentitan:top_pwc_rv_plic
      - lowrisc:ip:aon_timer
      - lowrisc:systems:top_pwc_soc_proxy
      - lowrisc:tlul:headers
      - lowrisc:prim:all
      - lowrisc:prim:mubi
      - lowrisc:systems:top_pwc_pkg
    files:
      - rtl/autogen/top_pwc_rnd_cnst_pkg.sv
      - rtl/autogen/top_pwc.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_pwc.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_pwc.waiver
    file_type: waiver

  files_veriblelint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_pwc.vbw
    file_type: veribleLintWaiver


parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

targets:
  default: &default_target
    filesets:
      - tool_verilator   ? (files_verilator_waiver)
      - tool_ascentlint  ? (files_ascentlint_waiver)
      - tool_veriblelint ? (files_veriblelint_waiver)
      - files_rtl_generic
    toplevel: top_pwc

  sim:
    default_tool: icarus
    filesets:
      - files_rtl_generic
    toplevel: top_pwc

  lint:
    <<: *default_target
    default_tool: verilator
    parameters:
      - SYNTHESIS=true
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"

  syn:
    <<: *default_target
    # TODO: set default to DC once
    # this option is available
    # olofk/edalize#89
    default_tool: icarus
    parameters:
      - SYNTHESIS=true
    toplevel: top_pwc

  formal:
    <<: *default_target
    toplevel: top_pwc
