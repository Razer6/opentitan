name: lowrisc:pwc_dv:gpio_pwc_sim:0.1
description: "GPIO_PWC DV sim target"
filesets:
  files_rtl:
    depend:
      - lowrisc:pwc_ip:gpio_pwc:0.1

  files_dv:
    depend:
      - lowrisc:pwc_dv:gpio_pwc_test
      - lowrisc:pwc_dv:gpio_pwc_sva
      - lowrisc:pwc_dv:gpio_pwc_if
    files:
      - tb/tb.sv
    file_type: systemVerilogSource

targets:
  sim: &sim_target
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    default_tool: vcs

  lint:
    <<: *sim_target
