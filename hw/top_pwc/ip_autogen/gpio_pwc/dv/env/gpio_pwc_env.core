name: lowrisc:pwc_dv:gpio_pwc_env:0.1
description: "GPIO DV UVM environmnt"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:ralgen
      - lowrisc:dv:cip_lib
    files:
      - gpio_pwc_env_pkg.sv
      - gpio_pwc_env_cfg.sv: {is_include_file: true}
      - gpio_pwc_env_cov.sv: {is_include_file: true}
      - gpio_pwc_scoreboard.sv: {is_include_file: true}
      - gpio_pwc_env.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_vseq_list.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_base_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_common_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_smoke_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_rand_intr_trigger_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_random_dout_din_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_dout_din_regs_random_rw_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_random_long_reg_writes_reg_reads_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_filter_stress_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_full_random_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_stress_all_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_intr_rand_pgm_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_intr_with_filter_rand_intr_event_vseq.sv: {is_include_file: true}
      - seq_lib/gpio_pwc_rand_straps_vseq.sv : {is_include_file: true}
    file_type: systemVerilogSource

generate:
  ral:
    generator: ralgen
    parameters:
      name: gpio_pwc
      ip_hjson: ../../data/gpio_pwc.hjson
    position: prepend

targets:
  default:
    filesets:
      - files_dv
    generate:
      - ral
