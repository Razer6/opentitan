CAPI=2:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: lowrisc:pwc_dv:gpio_pwc_pwc_sva:0.1
description: "GPIO_PWC assertion modules and bind file."
filesets:
  files_dv:
    depend:
      - lowrisc:tlul:headers
      - lowrisc:fpv:csr_assert_gen
    files:
      - gpio_pwc_bind.sv
    file_type: systemVerilogSource

  files_formal:
    depend:
      - lowrisc:pwc_ip:gpio_pwc_pwc:0.1

generate:
  csr_assert_gen:
    generator: csr_assert_gen
    parameters:
      spec: ../../data/gpio_pwc.hjson

targets:
  default: &default_target
    filesets:
      - files_dv
    generate:
      - csr_assert_gen

  formal:
    <<: *default_target
    filesets:
      - files_formal
      - files_dv
    toplevel: gpio_pwc
