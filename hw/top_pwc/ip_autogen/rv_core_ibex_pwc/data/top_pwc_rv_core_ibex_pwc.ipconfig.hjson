{
  instance_name: top_pwc_rv_core_ibex_pwc
  param_values:
  {
    num_regions: 2
    sim_window_address: 1088
    racl_support: true
    module_instance_name: rv_core_ibex_pwc
    topname: pwc
    uniquified_modules:
    {
      gpio: gpio_pwc
      rv_core_ibex: rv_core_ibex_pwc
      racl_ctrl: racl_ctrl_pwc
      ac_range_check: ac_range_check_pwc
      rv_plic: rv_plic_pwc
    }
  }
  dtgen:
  {
    num_regions:
    {
      type: uint8
      name: num_regions
      doc: Number of translatable regions per ibex bus
    }
  }
}
