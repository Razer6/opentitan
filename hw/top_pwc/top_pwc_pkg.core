name: "lowrisc:systems:top_pwc_top_pkg:0.1"
description: "Autogenerated top_pwc_pkg used in RTL and DV."
virtual:
  - lowrisc:constants:top_pkg

filesets:
  files_rtl:
    files:
      - rtl/autogen/top_pwc_pkg.sv
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl
