        InstSize: 32768
        NumRamInst: 2
        FlopRamOutput: 1
        EccCorrection: 1
        FlopWdataScramble: 1
        FlopReadAddrScramble: 1
        Outstanding: 6
      }
      base_addrs:
      {
        regs:
        {
          hart: 0x211c0000
        }
        ram:
        {
          hart: 0x10000000
        }
      }
      memory:
      {
        ram:
        {
          label: ram_main
          swaccess: rw
          data_intg_passthru: "true"
          exec: True
          byte_write: True
          size: 0x10000
        }
      }
      outgoing_alert: pwc
