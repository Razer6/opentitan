        }
        {
          name: InstrExec
          desc: Support execution from SRAM
          type: bit
          default: "0"
          local: "false"
          expose: "true"
          name_top: SramCtrlRetAonInstrExec
        }
        {
          name: NumPrinceRoundsHalf
          desc: Number of PRINCE half rounds for the SRAM scrambling feature
          type: int
          default: "3"
          local: "false"
          expose: "true"
          name_top: SramCtrlRetAonNumPrinceRoundsHalf
        }
        {
          name: Outstanding
          desc: Number of outstanding TLUL transactions
          type: int
          default: 6
          local: "true"
          expose: "true"
          name_top: SramCtrlRetAonOutstanding
        }
        {
          name: EccCorrection
          desc: Enable single-bit error correction and error logging
          type: bit
          default: 1
          local: "false"
          expose: "true"
          name_top: SramCtrlRetAonEccCorrection
        }
        {
          name: FlopRamOutput
          desc: Add a flop stage after the RAM macro output.
          type: bit
          default: 1
          local: "false"
          expose: "true"
          name_top: SramCtrlRetAonFlopRamOutput
        }
        {
          name: FlopWdataScramble
          desc: Add a flop stage after the write data scrambler.
          type: bit
          default: "0"
          local: "false"
          expose: "true"
          name_top: SramCtrlRetAonFlopWdataScramble
        }
        {
          name: FlopReadAddrScramble
          desc: Add a flop stage after the address scrambler for reads.
          type: bit
          default: "0"
          local: "false"
          expose: "true"
          name_top: SramCtrlRetAonFlopReadAddrScramble
        }
        {
          name: FlopEccOutput
          desc: Add a flop stage after the ECC output.
          type: bit
          default: "0"
          local: "true"
          expose: "true"
          name_top: SramCtrlRetAonFlopEccOutput
        }
      ]
      inter_signal_list:
      [
