//
// Pinmux DIO Pads Configuration
// There are 73 bytes covering every pad.
// Each byte is described as follows:
//   0: pull-up enable
//   1: pull-down enable
//   2: schmitt trigger enable
//   3: reserved
//   4-6: drive strength
//   7: override enable
//
// This is a configuration file that is used as the input for the
// opentitantool `otp creator-sw-cfg` command.
//
// A new CREATOR_SW_CFG partition can be generated with the following
// command:
// $ bazel run //sw/host/opentitantool \
//     -- otp creator-sw-cfg \
//     -c config_creator_sw_cfg.hjson \
//     -o creator_sw_cfg_ga0.hjson
//

{
  "configs": [
    {
      "name": "CREATOR_SW_CFG_DIO_ATTR",
      "items": [
        {
          "name": "SpiHost0Sd0",
          "value": "0xc0"
        },
        {
          "name": "SpiHost0Sd1",
          "value": "0xc0"
        },
        {
          "name": "SpiHost0Sd2",
          "value": "0xc0"
        },
        {
          "name": "SpiHost0Sd3",
          "value": "0xc0"
        },
        {
          "name": "SpiDeviceSd1",
          "value": "0xc0"
        },
        {
          "name": "GpioGpio0",
          "value": "0x81"
        },
        {
          "name": "SpiDeviceSck",
          "value": "0x86"
        },
        {
          "name": "SpiDeviceCsb",
          "value": "0x81"
        },
        {
          "name": "SpiHost0Sck",
          "value": "0xc0"
        },
        {
          "name": "SpiHost0Csb",
          "value": "0xc0"
        },
      ]
    }
  ]
}
