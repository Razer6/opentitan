`verilator_config

// The RDP OTP module doesn't use vendor-specific parameters
lint_off -rule UNUSED -file "*/rtl/prim_rdp_otp.sv" -match "*VendorTestOffset*"
lint_off -rule UNUSED -file "*/rtl/prim_rdp_otp.sv" -match "*VendorTestSize*"
