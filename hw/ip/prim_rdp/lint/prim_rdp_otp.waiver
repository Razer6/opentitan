waive -rules GENERATE_NAME -location {rivos_tsmc_fuse_wrapper.sv} -regexp {Name 'fuse_data_arrays' does not match any pattern 'gen_\*', 'g_\*'} \
      -comment "generate blocks have a dependency on rvsys, leave it"
waive -rules GENERATE_NAME -location {rivos_tsmc_fuse_wrapper.sv} -regexp {Name 'fuse_ecc_arrays' does not match any pattern 'gen_\*', 'g_\*'} \
      -comment "generate blocks have a dependency on rvsys, leave it"
