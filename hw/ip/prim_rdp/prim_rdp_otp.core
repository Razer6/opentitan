name: "lowrisc:prim_rdp:otp"
description: "RDP Technology-independent One-Time Programmable (OTP) memory emulation"
filesets:
  files_rtl:
    depend:
      # need for rivos_tsmc_fuse_wrapper logic
      # not uniquefied yet, but does it work for nsEFUSE?
      - rivos:rdplib:rtl_primitives
      - rivos:rdplib:rdp_async
      - rivos:rdplib:rdp_gate
      - rivos:dv:rdv_assert_env
      - rivos:rdplib:dv_primitives
      - rivos:rdplib:chipware
      - lowrisc:prim:util
      - lowrisc:prim:ram_1p_adv
      - lowrisc:systems:ast_pkg
      - lowrisc:prim:otp_pkg
      - lowrisc:ip:otp_ctrl_pkg
      - lowrisc:ip:otp_ctrl_prim_reg_top
      - lowrisc:ip:rstmgr
      - rivos:prim:misc_dft_pkg
    files:
      - rtl/prim_rdp_otp.sv
      - rtl/rivos_tsmc_fuse_wrapper.sv
    file_type: systemVerilogSource
  
  files_tef:
    files:
      - "!skip_hard_macros ? (/ip/tsmc/n3e/release/efuse/tsmc/1.1.0.a/tef03fe256x32hd18_phrm/vlg/tef03fe256x32hd18_phrm_110a_ssgnp0p675v1p080vm40c.v)"
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
    files:
      - lint/prim_rdp_otp.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
    files:
      - lint/prim_rdp_otp.waiver
    file_type: waiver


targets:
  default:
    filesets:
      - tool_verilator  ? (files_verilator_waiver)
      - tool_ascentlint ? (files_ascentlint_waiver)
      - files_rtl
      - "!use_emul_memories ? (files_tef)"
