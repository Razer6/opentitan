name: "lowrisc:prim_rdp:ram_2p"
description: "prim"
virtual:
  - lowrisc:prim:ram_2p

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim_rdp:ram_2p_pkg
      - lowrisc:prim:util_memload
    files:
      - rtl/prim_ram_2p.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
