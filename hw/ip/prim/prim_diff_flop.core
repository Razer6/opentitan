name: "lowrisc:prim:prim_diff_flop"
description: "Flop repeater for differentially encoded signals"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim:flop
      - lowrisc:prim:prim_diff_pkg
    files:
      - rtl/prim_diff_flop.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
